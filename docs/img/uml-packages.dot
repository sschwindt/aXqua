digraph packages {
  graph [rankdir=TB, nodesep=0.5, ranksep=0.7, fontname="Helvetica,Arial,sans-serif"];
  node [shape=tab, style=filled, fillcolor="#f5f5f5", margin="0.2,0.12", fontname="Helvetica,Arial,sans-serif", fontsize=11];
  edge [style=dashed, arrowhead=vee, color="#555555", fontname="Helvetica,Arial,sans-serif", fontsize=9];
  plugin [label="QGIS plugin\nqgis_plugin/axqua"];
  cli [label="Command line\naxqua.cli, axqua.*cli"];
  jobs [label="Job system\naxqua.jobs"];
  install [label="Installation of the\nsimulation software\naxqua.install"];
  workflow [label="Workflow, studies\nand calibration\naxqua (top level)"];
  postproc [label="Figures and export\naxqua.postproc"];
  telemac [label="TELEMAC backend\naxqua.solvers.telemac"];
  openfoam [label="OpenFOAM backend\naxqua.solvers.openfoam"];
  config [label="Case description\naxqua.config"];
  core [label="Core\naxqua.core"];
  { rank=same; plugin; }
  { rank=same; cli; }
  { rank=same; jobs; install; }
  { rank=same; workflow; postproc; }
  { rank=same; telemac; openfoam; }
  { rank=same; config; }
  { rank=same; core; }
  plugin -> cli [label="  starts the program axqua", style=solid];
  cli -> config;
  cli -> core;
  cli -> install;
  cli -> jobs;
  cli -> openfoam;
  cli -> postproc;
  cli -> telemac;
  cli -> workflow;
  config -> core;
  core -> config;
  install -> core;
  install -> jobs;
  jobs -> config;
  jobs -> core;
  jobs -> workflow;
  openfoam -> config;
  openfoam -> core;
  openfoam -> jobs;
  openfoam -> postproc;
  openfoam -> workflow;
  postproc -> core;
  postproc -> workflow;
  telemac -> config;
  telemac -> core;
  telemac -> jobs;
  telemac -> workflow;
  workflow -> config;
  workflow -> core;
  workflow -> jobs;
  workflow -> openfoam;
  workflow -> telemac;
}
