digraph uml_backends {
  graph [rankdir=LR, nodesep=0.18, ranksep=1.0, fontname="Helvetica,Arial,sans-serif", fontsize=11, labeljust=l];
  node [shape=box, style=filled, fillcolor="#f5f5f5", fontname="Helvetica,Arial,sans-serif", fontsize=10, margin="0.12,0.06"];
  edge [color="#555555"];
  subgraph cluster_0 {
    label="axqua.core.registry"; color="#aaaaaa";
    CapabilitySpec [label="&#171;dataclass&#187;\nCapabilitySpec"];
    BackendSpec [label="&#171;dataclass&#187;\nBackendSpec"];
    SolverBackend [label="&#171;protocol&#187;\nSolverBackend"];
    BaseBackend [label="BaseBackend"];
  }
  subgraph cluster_1 {
    label="axqua.core.capabilities"; color="#aaaaaa";
    Capability [label="&#171;enumeration&#187;\nCapability"];
    Support [label="&#171;enumeration&#187;\nSupport"];
    CapabilityState [label="&#171;dataclass&#187;\nCapabilityState"];
    SolverStatus [label="&#171;dataclass&#187;\nSolverStatus"];
    CaseStatus [label="&#171;dataclass&#187;\nCaseStatus"];
  }
  subgraph cluster_2 {
    label="axqua.solvers.telemac.backend"; color="#aaaaaa";
    TelemacBackend [label="TelemacBackend"];
  }
  subgraph cluster_3 {
    label="axqua.solvers.openfoam.backend"; color="#aaaaaa";
    OpenFoamBackend [label="OpenFoamBackend"];
  }
  CapabilitySpec -> Support [arrowtail=diamond, dir=back];
  BackendSpec -> Capability [arrowtail=diamond, dir=back];
  BackendSpec -> CapabilitySpec [arrowtail=diamond, dir=back];
  CapabilityState -> Capability [arrowtail=diamond, dir=back];
  CapabilityState -> Support [arrowtail=diamond, dir=back];
  SolverStatus -> CapabilityState [arrowtail=diamond, dir=back];
  CaseStatus -> SolverStatus [arrowtail=diamond, dir=back];
  TelemacBackend -> BaseBackend [arrowhead=empty];
  OpenFoamBackend -> BaseBackend [arrowhead=empty];
  BaseBackend -> SolverBackend [arrowhead=empty, style=dashed];
}
