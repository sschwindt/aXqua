# French translation of the aXqua documentation, page troubleshooting/errors.
# Written by docs/i18n/translate.py. An entry with the comment "machine translation" is
# translated again when its English text changes. Delete that comment after reviewing an
# entry, and the translation is kept as long as the English text stays the same.
msgid ""
msgstr ""
"Project-Id-Version: aXqua\n"
"Language: fr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

# machine translation: argos b70609977a44
msgid "Error messages"
msgstr "Messages d'erreur"

# machine translation: argos cba979e7ca1f
msgid "An error means that aXqua could not complete a step. Errors appear in the log files with the level ``ERROR`` and in the message bar of the plugin (:doc:`tips-logfiles`)."
msgstr "Une erreur signifie qu'aXqua n'a pas pu accomplir une étape. Les erreurs apparaissent dans les fichiers journaux avec le niveau ``ERROR`` et dans la barre de messages de l'extension (:doc:`tips-logfiles`)."

# machine translation: argos 4525d08190fb
msgid "Each error belongs to one of five categories. The category determines where to look for the cause:"
msgstr "Chaque erreur appartient à l'une des cinq catégories. La catégorie détermine où chercher la cause :"

# machine translation: argos 11c108ad75a9
msgid "Category"
msgstr "Catégorie"

# machine translation: argos a293a9c129c9
msgid "Code"
msgstr "Code"

# machine translation: argos 07c9dbb4b901
msgid "Where to look"
msgstr "Où chercher"

# machine translation: argos 3a6ea3e60310
msgid "Case file"
msgstr "Fichier de cas"

# machine translation: argos 4215aaa54666
msgid "An entry of the case file is missing, misspelled or has an invalid value."
msgstr "Une entrée du fichier de cas est manquante, mal orthographiée ou a une valeur non valide."

# machine translation: argos 632be0c37a09
msgid "Geodata"
msgstr "Géodonnées"

# machine translation: argos 5a324633bf77
msgid "An input layer or raster is missing or lacks a required property."
msgstr "Une entrée couche ou raster est manquante ou manque une propriété requise."

# machine translation: argos 3ba91fc3a9ca
msgid "Simulation software"
msgstr "Logiciel de simulation"

# machine translation: argos f5767ab7705c
msgid "TELEMAC or OpenFOAM cannot be reached with the current solver bindings."
msgstr "TELEMAC ou OpenFOAM ne peuvent pas être atteints avec les liaisons solveur actuelles."

# machine translation: argos 88713fac4a66
msgid "Simulation"
msgstr "Simulation"

# machine translation: argos bf3c09b3b1ca
msgid "The simulation code started and stopped with an error. Read its own output."
msgstr "Le code de simulation a commencé et s'est arrêté avec une erreur. Lisez sa propre sortie."

# machine translation: argos 4ad3d02803d8
msgid "Mesh"
msgstr "Maillage"

# machine translation: argos 603679677c4e
msgid "The mesh could not be created or is not usable."
msgstr "Le maillage n'a pas pu être créé ou n'est pas utilisable."

# machine translation: argos 885ae97481c7
msgid "Where aXqua knows a remedy, the error message contains it. For a failed job, the error is stored with its code and its remedy in the file ``status.json`` of the job and is shown below the job list of the plugin."
msgstr "Lorsque aXqua connaît un remède, le message d'erreur le contient. Pour une tâche ratée, l'erreur est stockée avec son code et son remède dans le fichier ``status.json`` de la tâche et est montrée sous la liste tâche de l'extension."

# machine translation: argos 8615ae99e003
msgid "Unique codes for the individual errors within these categories, which link each message to its explanation, are not yet available in this version."
msgstr "Des codes uniques pour les erreurs individuelles dans ces catégories, qui relient chaque message à son explication, ne sont pas encore disponibles dans cette version."

# machine translation: argos 95d8bf9df00f
msgid "Installation"
msgstr "Installation"

# machine translation: argos 3011ddad0833
msgid "The aXqua program is not installed in the active Python environment. Activate the environment and install aXqua (:doc:`../installation/qgis-plugin`). A copy of the repository alone is not sufficient, because the source code lies in the subfolder ``src/``."
msgstr "Le programme aXqua n'est pas installé dans l'environnement Python actif. Activer l'environnement et installer aXqua (:doc:`../installation/qgis-plugin`). Une copie du dépôt seul n'est pas suffisante, car le code source se trouve dans le sous-dossier ``src/``."

# machine translation: argos c82e6ba1f741
msgid "A system library that the geospatial packages require does not match their version. This occurs when packages of different origin are mixed in one environment. Create the environment again from ``environment.yml``, which installs all geospatial packages consistently from one source."
msgstr "Une bibliothèque système que les paquets géospatials exigent ne correspond pas à leur version. Cela se produit lorsque des colis d'origine différente sont mélangés dans un même environnement. Créez à nouveau l'environnement à partir de ``environment.yml``, qui installe tous les paquets géospatials systématiquement à partir d'une source."

# machine translation: argos 075a2a42d923
msgid "``axqua could not be found`` (plugin)"
msgstr "``axqua could not be found`` (extension)"

# machine translation: argos a8ecdef97860
msgid "The plugin did not find the program ``axqua``. The message lists the three places that were searched. Enter the full path of the program in *aXqua > Settings* and click *Test* (:doc:`../installation/qgis-plugin`)."
msgstr "L'extension n'a pas trouvé le programme ``axqua``. Le message énumère les trois endroits qui ont été fouillés. Entrez le chemin complet du programme à *aXqua > Settings* et cliquez sur *Test* (:doc:`../installation/qgis-plugin`)."

# machine translation: argos ea0db95d380d
msgid "Installation of the simulation software"
msgstr "Installation du logiciel de simulation"

# machine translation: argos f96660627a1f
msgid "The *Check* tab of an installation wizard, the *Installation* tab of a failed installation, and ``axqua install`` report the following errors. An installation cannot be started with an error of the *Check* tab."
msgstr "L'onglet *Check* d'un assistant d'installation, l'onglet *Installation* d'une installation échouée, et ``axqua install`` signaler les erreurs suivantes. Une installation ne peut pas être démarrée avec une erreur de l'onglet *Check*."

# machine translation: argos 2a0ba85dcaa5
msgid "The installer scripts exist for Debian 12, Ubuntu 22.04, Ubuntu 24.04 and Linux Mint 22, and the TELEMAC installer does not cover Ubuntu 22.04. The OpenFOAM installer and the VisIt installer additionally require an x86-64 processor. On a system that is built on one of the supported systems, select the base system under *Further settings* on the *Settings* tab of the wizard. Otherwise install the program by hand and enter it in the profile editor (:doc:`../installation/simulation-software`)."
msgstr "Les scripts d'installation existent pour Debian 12, Ubuntu 22.04, Ubuntu 24.04 et Linux Mint 22, et l'installateur TELEMAC ne couvre pas Ubuntu 22.04. L'installateur OpenFOAM et l'installateur VisIt nécessitent en outre un processeur x86-64. Sur un système construit sur l'un des systèmes pris en charge, sélectionnez le système de base sous *Further settings* sur l'onglet *Settings* de l'assistant. Sinon, installez le programme à la main et entrez-le dans l'éditeur de profil (:doc:`../installation/simulation-software`)."

# machine translation: argos cae2b1323aec
msgid "The simulation programs do not run in Windows itself. Install a Linux distribution in the Windows Subsystem for Linux and start the installation there (:doc:`../installation/simulation-software`)."
msgstr "Les programmes de simulation ne fonctionnent pas dans Windows lui-même. Installez une distribution Linux dans le sous-système Windows pour Linux et démarrez l'installation (:doc:`../installation/simulation-software`)."

# machine translation: argos 3f471cefb0b2
msgid "Start QGIS or the terminal as an ordinary user. Administrator rights are needed for the system packages only."
msgstr "Démarrer QGIS ou terminal en tant qu'utilisateur ordinaire. Les droits d'administrateur sont nécessaires uniquement pour les paquets système."

# machine translation: argos 8e74f0362646
msgid "In the Windows Subsystem for Linux, a folder below ``/mnt/`` belongs to Windows. Select a folder in the Linux file system, for example in the home folder."
msgstr "Dans le sous-système Windows pour Linux, un dossier ci-dessous ``/mnt/`` appartient à Windows. Sélectionnez un dossier dans le système de fichiers Linux, par exemple dans le dossier d'accueil."

# machine translation: argos 596271970a4b
msgid "Neither TELEMAC nor OpenFOAM can be built in a folder whose path contains a space. Select another folder."
msgstr "Ni TELEMAC ni OpenFOAM ne peuvent être construits dans un dossier dont le chemin contient un espace. Sélectionnez un autre dossier."

# machine translation: argos 85dbcaab0da5
msgid "At the end of an installation for all users, the whole installation folder is handed over to the administrator. A folder such as ``/opt`` or ``/usr`` itself, or your home folder, would be handed over with everything else it contains. Select a folder of its own, such as ``/opt/telemac``."
msgstr "À la fin d'une installation pour tous les utilisateurs, l'ensemble de l'installation dossier est remis à l'administrateur. Un dossier comme ``/opt`` ou ``/usr`` lui-même, ou votre dossier d'origine, serait remis avec tout ce qu'il contient. Choisissez un dossier propre, comme ``/opt/telemac``."

# machine translation: argos e822eb3e9367
msgid "The installation folder of an installation for all users belongs to somebody else and was not made by an installation of aXqua for all users, so aXqua does not take it over. Select a folder that does not exist yet."
msgstr "L'installation du dossier d'une installation pour tous les utilisateurs appartient à quelqu'un d'autre et n'a pas été faite par une installation d'aXqua pour tous les utilisateurs, de sorte qu'aXqua ne la reprend pas. Sélectionnez un dossier qui n'existe pas encore."

# machine translation: argos df27ed87fa0c
msgid "An installation for all users needs the password of an administrator before and after the build, and this session could neither open the password dialog of the desktop nor ask in a terminal. This happens to an installation that was started detached, without a desktop. Start it in a terminal with ``axqua install start <program> --for-all-users --foreground``, or have an administrator run the command that the message names and start the installation again. Nothing has been built at that point."
msgstr "Une installation pour tous les utilisateurs a besoin du mot de passe d'un administrateur avant et après la construction, et cette session ne pouvait pas ouvrir la boîte de dialogue de mot de passe du bureau ni demander à terminal. Cela arrive à une installation qui a été démarrée détachée, sans bureau. Commencer par un terminal avec ``axqua install start <program> --for-all-users --foreground``, ou faire exécuter par un administrateur la commande que le nom du message et recommencer l'installation. Rien n'a été construit à ce stade."

# machine translation: argos f144155e97f9
msgid "The OpenFOAM installer installs into a new folder or continues an installation of its own. Select a folder that does not exist yet."
msgstr "L'installateur OpenFOAM installe dans un nouveau dossier ou poursuit une installation propre. Sélectionnez un dossier qui n'existe pas encore."

# machine translation: argos 47fbdc513e84
msgid "The OpenFOAM installer continues only what the same version of it started with the same OpenFOAM. Open the wizard with *Install OpenFOAM...*, answer *Yes* to the question whether to install again, and select *Remove the existing installation and install it again in its folder*, or select a new folder."
msgstr "L'installateur OpenFOAM continue seulement ce que la même version a commencé avec le même OpenFOAM. Ouvrez l'assistant avec *Install OpenFOAM...*, répondez *Yes* à la question de savoir s'il faut installer à nouveau et sélectionnez *Remove the existing installation and install it again in its folder*, ou sélectionnez un nouveau dossier."

# machine translation: argos 72cb67e6e23e
msgid "*Remove the existing installation* was selected for a folder that holds no installation that an installer of aXqua made. aXqua removes only such installations. Select the folder of the existing installation, or install into a new folder."
msgstr "*Remove the existing installation* a été sélectionné pour un dossier qui ne détient aucune installation qu'un installateur de aXqua fait. aXqua ne supprime que ces installations. Sélectionnez le dossier de l'installation existante, ou installez-le dans un nouveau dossier."

# machine translation: argos f3f75cc667f9
msgid "``the SALOME archive ... does not exist`` or ``the OpenFOAM environment script ... does not exist``"
msgstr "``the SALOME archive ... does not exist`` ou ``the OpenFOAM environment script ... does not exist``"

# machine translation: argos a3798b71ad3d
msgid "A file that was selected on the *Settings* tab of the wizard is not on this computer. Select it again, or clear the field."
msgstr "Un fichier sélectionné sur l'onglet *Settings* de l'assistant n'est pas sur cet ordinateur. Sélectionnez-le à nouveau ou videz-le."

# machine translation: argos fe879e69663e
msgid "The sediment transport solvers are built for OpenFOAM v2406 and the selected installation is another version. Select the file ``etc/bashrc`` of OpenFOAM v2406, or let the wizard compile OpenFOAM."
msgstr "Le transport des sédiments solveurs sont construits pour OpenFOAM v2406 et l'installation sélectionnée est une autre version. Sélectionnez le fichier ``etc/bashrc`` d'OpenFOAM v2406 ou laissez le assistant compiler OpenFOAM."

# machine translation: argos ba931cb62c95
msgid "aXqua downloads the TELEMAC installer scripts before it checks the computer and did not reach the repository. The OpenFOAM installer and the source code of Olsen's solvers are shipped with aXqua and are not downloaded. Verify the internet connection. For a computer without a connection, copy the `installer repository <https://github.com/Ecohydraulics/numerical-software-installers>`_ onto it and select its folder under *Further settings* (in a terminal: the environment variable ``AXQUA_INSTALLERS``)."
msgstr "aXqua télécharge les scripts d'installation TELEMAC avant qu'il ne vérifie l'ordinateur et n'a pas tronçon le dépôt. L'installateur OpenFOAM et le code source d'Olsen solveurs sont envoyés avec aXqua et ne sont pas téléchargés. Vérifier la connexion Internet. Pour un ordinateur sans connexion, copiez le `dépôt d'installation <https://github.com/Ecohydraulics/numerical-software-installers>`_ et sélectionnez son dossier sous *Further settings* (dans un terminal: la variable d'environnement ``AXQUA_INSTALLERS``)."

# machine translation: argos 892509a23965
msgid "The OpenFOAM installer requires a newer Python than the one that runs aXqua, and aXqua found no newer one. Install Python 3.12 or newer, for example with Miniforge, and install aXqua with it."
msgstr "L'installateur OpenFOAM nécessite un Python plus récent que celui qui exécute aXqua, et aXqua n'en a trouvé aucun plus récent. Installez Python 3.12 ou plus récent, par exemple avec Miniforge, et installez aXqua avec."

# machine translation: argos 936d02474481
msgid "A step of the installation failed. The message quotes the last lines of the installation log, which normally name the cause, and gives the location of the complete log. Typical causes are a missing system package, an interrupted download and a full drive. Correct the cause and start the installation again with the same folder: the installer continues with what is already downloaded and built."
msgstr "Une étape de l'installation a échoué. Le message cite les dernières lignes du journal d'installation, qui nomment normalement la cause, et indique l'emplacement du journal complet. Les causes typiques sont un paquet système manquant, un téléchargement interrompu et un lecteur complet. Corriger la cause et recommencer l'installation avec le même dossier : l'installateur continue avec ce qui est déjà téléchargé et construit."

# machine translation: argos 6979db1cb8b3
msgid "The lines ``remote: Retry later`` and ``error: 429`` mean that the download server of TELEMAC temporarily refuses further requests, which occurs after many downloads from one network in a short time. Wait a few minutes and start the installation again."
msgstr "Les lignes ``remote: Retry later`` et ``error: 429`` signifient que le serveur de téléchargement de TELEMAC refuse temporairement d'autres demandes, ce qui se produit après de nombreux téléchargements d'un réseau en peu de temps. Attendez quelques minutes et redémarrez l'installation."

# machine translation: argos c1179425a92f
msgid "The installer reported success, but a program that it should have built is missing, so the build failed in part. Search the installation log for the first line that contains ``Error``."
msgstr "L'installateur a signalé un succès, mais un programme qu'il aurait dû construire est manquant, donc la construction a échoué en partie. Recherchez le journal d'installation pour la première ligne qui contient ``Error``."

# machine translation: argos 9191d40bea9d
msgid "The installation consists of a package of the operating system, and the package is not installed. Install the system packages that the *Check* tab of the wizard lists, then start the installation again."
msgstr "L'installation consiste en un paquet du système d'exploitation, et le paquet n'est pas installé. Installez les paquets système que l'onglet *Check* des listes assistant, puis redémarrez l'installation."

# machine translation: argos d3f897d791f6
msgid "With the selection *ParaView only*, the installation of the postprocessors downloads nothing: ParaView is a package of the operating system, and the wizard only enters it in the profile. Install the system packages that the *Check* tab lists, which requires administrator rights, and click *Check again* (:ref:`install-paraview`)."
msgstr "Avec la sélection *ParaView only*, l'installation des postprocesseurs ne télécharge rien : ParaView est un paquet du système d'exploitation, et l'assistant ne l'entre que dans le profil. Installez les paquets système que l'onglet *Check* listes, qui nécessite des droits d'administrateur, et cliquez sur *Check again* (:ref:`install-paraview`)."

# machine translation: argos 8e4643f507c7
msgid "The process of the installation disappeared, typically because the computer was restarted or the user was logged out. Start the installation again with the same folder."
msgstr "Le processus d'installation a disparu, généralement parce que l'ordinateur a été redémarré ou que l'utilisateur a été déconnecté. Recommencer l'installation avec le même dossier."

# machine translation: argos b9aedf6c8667
msgid "Check of a case"
msgstr "Vérification d'un cas"

# machine translation: argos 8f6e1127ebc6
msgid "The check of a case (*Check* on the *Case Setup* tab, *Save* in the case settings, or ``axqua check <case-file>``) reports the following errors. The plugin shows each of them as a dark red triangle next to the setting concerned. An error does not prevent saving the case, but the model cannot be built until it is corrected."
msgstr "La vérification d'un cas (*Check* sur l'onglet *Case Setup*, *Save* dans les paramètres cas, ou ``axqua check <case-file>``) signale les erreurs suivantes. L'extension montre chacun d'eux comme un triangle rouge foncé à côté du réglage concerné. Une erreur n'empêche pas d'enregistrer le cas, mais le modèle ne peut être construit tant qu'il n'est pas corrigé."

# machine translation: argos f3f75cc667f9
msgid "``... is required`` or ``... is not set``"
msgstr "``... is required`` ou ``... is not set``"

# machine translation: argos 0e72f12d633a
msgid "A setting that every case needs is empty, for example the terrain model, the model outline, or the inflow and outflow lines. Select the file in the case settings (*Open case settings...* on the *Case Setup* tab)."
msgstr "Un réglage dont chaque cas a besoin est vide, par exemple le modèle de terrain, le contour du modèle, ou les lignes d'entrée et de sortie. Sélectionnez le fichier dans les paramètres cas (*Open case settings...* sur l'onglet *Case Setup*)."

# machine translation: argos 16c36d023d9d
msgid "The case file names a file that is not at the stated location. A path that does not start at the root of the drive is read relative to the folder of the case file. Select the file again in the case settings."
msgstr "Le fichier de cas nomme un fichier qui n'est pas à l'endroit indiqué. Un chemin qui ne commence pas à la racine du lecteur est lu par rapport au dossier du fichier de cas. Sélectionnez à nouveau le fichier dans les paramètres cas."

# machine translation: argos f3f75cc667f9
msgid "``... is not a setting of a case`` or ``... is not a block of a case file``"
msgstr "``... is not a setting of a case`` ou ``... is not a block of a case file``"

# machine translation: argos f96af4845023
msgid "The case file contains a name that aXqua does not know, in most cases because of a typing error. The message proposes the name that was probably meant. Correct the name in the case file with a text editor."
msgstr "Le fichier de cas contient un nom que aXqua ne connaît pas, dans la plupart des cas à cause d'une erreur de saisie. Le message propose le nom qui était probablement voulu. Corriger le nom dans le fichier de cas avec un éditeur de texte."

# machine translation: argos 84ace3ea5ce4
msgid "The structure of the file is damaged, for example by a missing colon or a wrong indentation. The message names the line. Correct it with a text editor. The case settings keep the original of a case file as ``<name>.bak`` the first time it saves."
msgstr "La structure du fichier est endommagée, par exemple par un côlon manquant ou une indentation incorrecte. Le message désigne la ligne. Corriger avec un éditeur de texte. Les paramètres cas conservent l'original d'un fichier de cas comme ``<name>.bak`` la première fois qu'il économise."

# machine translation: argos 197625d99cf8
msgid "The file is valid YAML but not a case file, for example a list. Select the correct file."
msgstr "Le fichier est valide YAML mais pas un fichier de cas, par exemple une liste. Sélectionnez le bon fichier."

# machine translation: argos bb0720684142
msgid "The file does not exist or may not be read. Verify the path and the access rights."
msgstr "Le fichier n'existe pas ou peut ne pas être lu. Vérifier le chemin et les droits d'accès."

# machine translation: argos ea0b969845ad
msgid "Profile of this computer"
msgstr "Profil de cet ordinateur"

# machine translation: argos 7cb1c5efb2e6
msgid "The check of the profile (*Check* on the *Configuration* tab, or ``axqua profile check``) reports the following errors. The plugin shows each of them as a dark red triangle next to the entry concerned. An error does not prevent saving the profile, but the function that depends on the entry does not work until the entry is corrected."
msgstr "La vérification du profil (*Check* sur l'onglet *Configuration*, ou ``axqua profile check``) signale les erreurs suivantes. L'extension montre chacun d'eux comme un triangle rouge foncé à côté de l'entrée concernée. Une erreur n'empêche pas l'enregistrement du profil, mais la fonction qui dépend de l'entrée ne fonctionne pas avant que l'entrée soit corrigée."

# machine translation: argos 9efeeeb8caa7
msgid "``the ... does not exist``, ``the ... launcher ... is not executable`` or ``the ... program was not found in the installation folder ...``"
msgstr "``the ... does not exist``, ``the ... launcher ... is not executable`` ou ``the ... program was not found in the installation folder ...``"

# machine translation: argos 86eb437c1bc4
msgid "The profile names a program file that is not on this computer, or that may not be started, or it names an installation folder that does not contain the program. Select the file again in the profile editor."
msgstr "Le profil nomme un fichier de programme qui n'est pas sur cet ordinateur, ou qui ne peut pas être démarré, ou il nomme un dossier d'installation qui ne contient pas le programme. Sélectionnez à nouveau le fichier dans l'éditeur de profil."

# machine translation: argos f73000264b7a
msgid "The profile names an environment script that is not on this computer. Select the script of the installation (:ref:`solver-bindings`)."
msgstr "Le profil nomme un script d'environnement qui n'est pas sur cet ordinateur. Sélectionnez le script de l'installation (:ref:`solver-bindings`)."

# machine translation: argos 199c5a83b800
msgid "aXqua loaded the environment script and could not start the simulation program. The message states what is missing. Verify in a terminal that the installation works by itself, and that the profile names the environment script of this installation."
msgstr "aXqua a chargé le script environnement et n'a pas pu démarrer le programme de simulation. Le message indique ce qui manque. Vérifiez dans un terminal que l'installation fonctionne par elle-même, et que le profil nomme le script environnement de cette installation."

# machine translation: argos 10e0a8a35bff
msgid "aXqua cannot create files in the folder for jobs. Select a folder on a drive with write access and sufficient free space."
msgstr "aXqua ne peut pas créer de fichiers dans le dossier pour tâches. Sélectionnez un dossier sur un lecteur avec accès écrit et suffisamment d'espace libre."

# machine translation: argos a2e7ecbe015a
msgid "``the launcher must be one of ...``, ``the number of processes must be at least 1`` and similar"
msgstr "``the launcher must be one of ...``, ``the number of processes must be at least 1`` et similaires"

# machine translation: argos 366faf09f98a
msgid "An entry of the profile has a value that is not possible. The message names the entry and the permitted values."
msgstr "Une entrée du profil a une valeur qui n'est pas possible. Le message désigne l'entrée et les valeurs autorisées."

# machine translation: argos 32ae3ea69da7
msgid "A block of the case file contains an entry that aXqua does not know, usually because of a typing error. The message names the block and the entry. Compare the spelling with the template in ``cases/case-template/``."
msgstr "Un bloc du fichier de cas contient une entrée que aXqua ne connaît pas, généralement à cause d'une erreur de saisie. Le message désigne le bloc et l'entrée. Comparez l'orthographe avec le modèle dans ``cases/case-template/``."

# machine translation: argos f3f75cc667f9
msgid "``telemac.pysource is not set`` or ``TELEMAC pysource script not found``"
msgstr "``telemac.pysource is not set`` ou ``TELEMAC pysource script not found``"

# machine translation: argos 90f704ab0f7d
msgid "aXqua does not know where TELEMAC is installed, or the stated environment script does not exist. Create the profile of the computer with ``axqua profile init``, or correct its binding for TELEMAC (:ref:`solver-bindings`)."
msgstr "aXqua ne sait pas où TELEMAC est installé, ou le script d'environnement indiqué n'existe pas. Créer le profil de l'ordinateur avec ``axqua profile init``, ou corriger sa liaison pour TELEMAC (:ref:`solver-bindings`)."

# machine translation: argos e21cbd874c72
msgid "The outflow boundary is set to a constant water surface elevation, but no elevation is given. Enter ``boundaries.prescribed_elevation``, or select another outflow condition (:ref:`case-boundaries`)."
msgstr "La frontière de sortie est réglée sur une cote de la surface libre, mais aucune élévation n'est donnée. Entrez ``boundaries.prescribed_elevation``, ou sélectionnez une autre condition de sortie (:ref:`case-boundaries`)."

# machine translation: argos 22027ff35219
msgid "The pre-wetted start fills the channel zones with water and therefore requires a mesh zone layer with a zone whose name contains ``channel`` (:ref:`case-initialization`)."
msgstr "Le début préhumide remplit les zones de chenal avec de l'eau et nécessite donc une couche zone de maillage avec une zone dont le nom contient ``channel`` (:ref:`case-initialization`)."

# machine translation: argos ed37b3be884d
msgid "A morphodynamic case requires the measured bed change as reference. Enter a second terrain model or a DEM of difference (:ref:`case-morphodynamics`)."
msgstr "Une morphodynamique cas nécessite le changement de lit mesuré comme référence. Entrez un deuxième modèle de terrain ou un MNT de différence (:ref:`case-morphodynamics`)."

# machine translation: argos e95906e24d3e
msgid "Preprocessing and simulations"
msgstr "Prétraitement et simulation"

# machine translation: argos f3f75cc667f9
msgid "``BAMG failed`` or ``Fatal error in the meshgenerator``"
msgstr "``BAMG failed`` ou ``Fatal error in the meshgenerator``"

# machine translation: argos 84e5cf1e5e7a
msgid "The mesh generator could not create the mesh, also after repeating the attempt with adapted settings. The edge lengths of neighboring mesh zones differ too strongly. Increase the smallest edge length or enlarge the refinement zone, so that the triangle size can change gradually."
msgstr "Le générateur maillage ne pouvait pas créer le maillage, aussi après avoir répété la tentative avec des paramètres adaptés. Les longueurs de bord du voisin zones de maillage diffèrent trop fortement. Augmenter la plus petite longueur de bord ou agrandir la zone de raffinement, de sorte que la taille du triangle puisse changer progressivement."

# machine translation: argos 266aa1dba603
msgid "TELEMAC stops at the first time step with a message of the subroutine ``DEBIMP``"
msgstr "TELEMAC s'arrête au premier pas de temps avec un message de la sous-routine ``DEBIMP``"

# machine translation: argos 3f06e32b0507
msgid "The inflow cross section is dry, so that TELEMAC cannot distribute the discharge over it. Verify that the inflow line lies in the channel and that the water depth of the filled stretch at the inflow (``initialization.dry_start_depth``) covers the bed along the entire line."
msgstr "Le profil en travers d'entrée est sec, de sorte que TELEMAC ne peut pas distribuer le débit dessus. Vérifiez que la ligne d'entrée se trouve dans le chenal et que la hauteur d'eau du tronçon rempli à l'entrée (``initialization.dry_start_depth``) couvre le lit le long de la ligne entière."

# machine translation: argos ce54cbe759a1
msgid "The water depth or a velocity component left the range that the keyword ``LIMIT VALUES`` of the steering file allows, which is 1000 m/s for the velocity. Such a value is a numerical instability and not a flow. TELEMAC-2D itself ends such a run without an error code, so aXqua reads the stop from the listing and marks the job as ``FAILED``. The message states the quantity, its value, the coordinates of the mesh node, and the simulated time. Inspect the mesh, the bed elevation, and the initial water depth at these coordinates in QGIS. Common causes are a sink or an open boundary on cells that are almost dry, an initial water surface that is far from the steady one, and a time step that is too large (``hydrodynamics.desired_courant``). Internal exchange lines that are applied as source regions with a fixed rate (``boundaries.internal_sources: true``) can cause this stop at the first time step, because the discharge is then withdrawn from a narrow strip regardless of the water depth. Use the block ``gain_lose`` instead, which limits the withdrawal by the water depth (:ref:`preprocessing-telemac-choices`)."
msgstr "La hauteur d'eau ou un composant de vitesse a laissé la plage que le mot clé ``LIMIT VALUES`` du fichier de paramètres permet, soit 1000 m/s pour la vitesse. Une telle valeur est une instabilité numérique et non un flux. TELEMAC-2D se termine par une telle course sans code d'erreur, donc aXqua lit l'arrêt de la liste et marque la tâche comme ``FAILED``. Le message indique la quantité, sa valeur, les coordonnées du nœud du maillage et le temps simulé. Inspectez le maillage, la cote du fond et la hauteur d'eau initiale à ces coordonnées en QGIS. Les causes communes sont un évier ou une frontière ouverte sur des cellules qui sont presque sèches, une surface libre initiale qui est loin de la normale, et un pas de temps qui est trop grand (``hydrodynamics.desired_courant``). Les lignes d'échange internes qui sont appliquées en tant que régions sources à taux fixe (``boundaries.internal_sources: true``) peuvent provoquer cet arrêt au premier pas de temps, parce que le débit est ensuite retiré d'une bande étroite indépendamment de la hauteur d'eau. Utilisez plutôt le bloc ``gain_lose``, ce qui limite le retrait par la hauteur d'eau (:ref:`preprocessing-telemac-choices`)."

# machine translation: argos 2a16e1846e90
msgid "The water surface of the TELEMAC result drops in steps that exceed the local water depth, for example at the slots of a fish pass. A fixed lid cannot represent such a water surface. Use ``openfoam.mode: vof`` for this case (:ref:`preprocessing-openfoam-choices`)."
msgstr "La surface libre du TELEMAC se traduit par des chutes d'étapes qui dépassent la hauteur d'eau locale, par exemple aux fentes d'un passe-poissons. Un couvercle fixe ne peut représenter une telle surface libre. Utilisez ``openfoam.mode: vof`` pour ce cas (:ref:`preprocessing-openfoam-choices`)."

# machine translation: argos 2a8888bc3df5
msgid "Jobs"
msgstr "Tâches"

# machine translation: argos f966197c7bab
msgid "A job fails immediately after its start"
msgstr "Une tâche échoue immédiatement après son départ"

# machine translation: argos 1077ed4645fa
msgid "In most cases, the simulation software cannot be reached from the job. Read ``runner.log`` of the job and verify the profile with ``axqua profile check`` (:ref:`solver-bindings`). Note the warning about the ambient environment (:doc:`warnings`): a job does not inherit the settings of the terminal or of QGIS."
msgstr "Dans la plupart des cas, le logiciel de simulation ne peut être atteint depuis la tâche. Lisez ``runner.log`` de la tâche et vérifiez le profil avec ``axqua profile check`` (:ref:`solver-bindings`). Notez l'avertissement concernant l'environnement ambiant (:doc:`warnings`) : une tâche n'hérite pas des paramètres de la terminal ou de QGIS."

# machine translation: argos e788da57796a
msgid "The Linux user services that aXqua uses by default are not available, which is typical for some remote sessions. Submit the job with the option ``--launcher posix``, or select ``posix`` under *How jobs are detached* in the profile editor of the plugin (*Configuration* tab)."
msgstr "Les services utilisateurs Linux qu'aXqua utilise par défaut ne sont pas disponibles, ce qui est typique pour certaines sessions distantes. Soumettez la tâche avec l'option ``--launcher posix``, ou sélectionnez ``posix`` sous *How jobs are detached* dans l'éditeur de profil de l'extension (*Configuration* onglet)."

# machine translation: argos 97e128e3bdc4
msgid "A job remains in the state ``RUNNING`` although nothing is computed"
msgstr "Une tâche reste dans l'état ``RUNNING`` bien que rien n'est calculé"

# machine translation: argos d27d9127f926
msgid "Query the state with ``axqua status <job-id>`` or click *Refresh* below the job list. aXqua then verifies whether the process still exists and marks the job as ``FAILED`` if it does not, for example after a restart of the computer. The job can be submitted again."
msgstr "Interrogez l'État avec ``axqua status <job-id>`` ou cliquez sur *Refresh* sous la liste tâche. aXqua vérifie ensuite si le processus existe encore et marque la tâche comme ``FAILED`` si ce n'est pas le cas, par exemple après un redémarrage de l'ordinateur. La tâche peut être soumise à nouveau."

# machine translation: argos 80c2cf00ca7a
msgid "Plugin"
msgstr "Extension"

# machine translation: argos 9eddfcb97031
msgid "aXqua is missing from the list of installed plugins"
msgstr "aXqua est absent de la liste des extensions installées"

# machine translation: argos 844f9b7e5b43
msgid "QGIS lists a plugin only if it can read the file ``metadata.txt`` in the plugin folder, and it skips a plugin with an unreadable file without a message. Run ``python scripts/build_plugin_zip.py --check`` in the repository, which reads the file in the same way as QGIS and reports the line that cannot be read."
msgstr "QGIS liste une extension seulement s'il peut lire le fichier ``metadata.txt`` dans le dossier d'extension, et il saute une extension avec un fichier illisible sans message. Exécutez ``python scripts/build_plugin_zip.py --check`` dans le dépôt, qui lit le fichier de la même manière que QGIS et rapporte la ligne qui ne peut pas être lue."

# machine translation: argos 974902d5159e
msgid "The tabs of the workflow show only the note to add a case"
msgstr "Les onglets du workflow n'affichent que la note pour ajouter un cas"

# machine translation: argos 91c2e6727d52
msgid "No case is selected, or the case file could not be read. Add a case on the *Case Setup* tab. If the tabs remain empty, run ``axqua case-status <case-file> --no-write`` in a terminal to obtain the error message."
msgstr "Aucun cas n'est sélectionné, ou le fichier de cas n'a pu être lu. Ajoutez un cas sur l'onglet *Case Setup*. Si les onglets restent vides, lancez ``axqua case-status <case-file> --no-write`` dans un terminal pour obtenir le message d'erreur."

# machine translation: argos 2dafadf4f4bc
msgid "A result layer is loaded without colors"
msgstr "Un résultat couche est chargé sans couleurs"

# machine translation: argos e094b9d331ba
msgid "The name of a result variable differs from the expected one. The file is intact. Assign the style in the QGIS layer properties."
msgstr "Le nom d'une variable de résultat diffère de celui attendu. Le fichier est intact. Assignez le style dans les propriétés QGIS couche."
