# =============================================================================
# axqua case configuration - Inn river (Bavaria), 2025 hydro survey
# =============================================================================
# All relative paths resolve against THIS file's directory. The co-development
# dataset lives under user-sources/ (kept out of version control).
# Build with:
#   axqua cases/inn-2025-hydro/inn-KB08-2025-hydro.axq-case --check    # validate first
#   axqua cases/inn-2025-hydro/inn-KB08-2025-hydro.axq-case            # build the case
#
# Sections: project / telemac / geodata / boundaries / initialization / mesh /
#           friction / hydrodynamics / morphodynamics / ground_truth / calibration
# -----------------------------------------------------------------------------

project:
  name: inn                    # case name; used in titles and file headers
  crs_epsg: 25832              # [REQUIRED] project CRS, metric. 25832 = ETRS89/UTM32N
  sim_dir: axqua-case
  preprocessing_dir: axqua-case/preprocessing
  model_dir: axqua-case/simulation
  postprocessing_dir: axqua-case/postprocessing
  calibration_dir: axqua-case/calibration-validation

telemac:
  # Where TELEMAC is installed is a setting of the computer, not of the case:
  # see `axqua profile` (the Configuration tab of the QGIS plugin).
  solver: telemac2d            # telemac2d | telemac3d
  n_processors: 8

geodata:
  # Pure geodata files (boundary CONDITIONS are in `boundaries`, ground truth in
  # `ground_truth`). Paths resolve relative to THIS file; data under user-sources/.
  # ---- required -----------------------------------------------------------
  dem_initial: user-sources/geodata/dem-kb08.tif  # [REQUIRED] baseline terrain (GeoTIFF)
  boundary: user-sources/geodata/roi.gpkg         # [REQUIRED] ROI / max wetted extent polygon
  # ---- optional -----------------------------------------------------------
  # dem_target: user-sources/geodata/DEM-2025-20cm.tif   # 2nd DEM, enables morphodynamic target
  # mesh zones + channel centerline drive the anisotropic, flow-aligned meshing.
  mesh_zones: user-sources/geodata/mesh-zones.gpkg
  channel_centerline: user-sources/geodata/channel-centerline.gpkg
  # roughness zones (integer 'Zone ID') + a CSV mapping id -> ks drive the friction
  # zonation (zone 1 = channel ks ~0.2 m, zone 2 = floodplain ks ~0.5 m).
  roughness_zones: user-sources/geodata/roughness-zones.gpkg
  roughness_table: user-sources/geodata/roughness-table.csv
  # dem_of_difference: path/to/dod.tif         # precomputed bed-change raster (else from DEMs)

boundaries:
  # liquid boundaries: a LINE layer whose 'Type (inflow/outflow)' field tags each
  # line; the lines MUST coincide with the OUTER BOUNDS of the mesh zones. Inflow
  # nodes get 4 5 5, outflow nodes 5 4 4 (prescribed elevation) or 4 4 4 (free),
  # every other outer node a solid wall 2 2 2.
  liquid_boundaries: user-sources/geodata/liquid-boundaries.gpkg  # [REQUIRED for a build]
  # inflow: user-sources/hydraulics/inflow.csv   # OPTIONAL discharge series (for a later unsteady case)
  # THIS case's steady boundary conditions, read straight from here for steady2d.cas:
  # September 1-2, 2025, the calibration campaign: the gauge Muehldorf gave 54.7
  # m3/s on average over the measurement hours (Kraiburg 46.9). It was 35.0 before
  # 2026-10-15 and 47.3 (Kraiburg) until 2026-10-17.
  prescribed_flowrate: 54.7    # inflow Q [m3/s] for steady2d.cas
  # outflow (downstream) boundary type: stage_discharge (WSE from the rating curve
  # at the simulated Q) | elevation (fixed prescribed_elevation) | free (Neumann).
  # Outflow: the water level of a rating curve that aXqua computes from the terrain
  # cross section at the outflow line (normal flow, friction slope = bed slope) for
  # the discharge of each run, so every validation situation gets its own level.
  # The measured stage is too uncertain to prescribe (the user, 2026-10-17); a free
  # outflow (outflow_condition: free) is the fallback if this misbehaves.
  outflow_condition: stage_discharge
  rating_method: section

initialization:
  # dry start (default): the domain starts dry except a thin plug at the inflow line
  # (a fully dry bed makes DEBIMP abort at the prescribed-Q inflow). Tune if needed:
  # dry_start_depth: 0.5    # inflow-plug seed depth [m]
  # dry_start_extent: 7.5   # plug buffer around the inflow line [m] (default ~5 cells)
  # prewet_depth: 1.0       # ALTERNATIVE hotstart: wet the whole channel zone (needs geodata.mesh_zones)

mesh:
  # Anisotropic, flow-aligned strategy (used when geodata.mesh_zones +
  # geodata.channel_centerline are set). Each mesh-zone polygon is sized by its own
  # 'Max Edge Length (m)' field; the *_size values below are FALLBACKS.
  channel_size: 0.5            # fallback channel edge length (m)
  floodplain_size: 2.5         # fallback floodplain edge length (m); default outside all zones
  refinement_size: 0.5         # fallback 'refinement' zone edge length (m)
  # The KB08 mesh-zones layer names its field without the unit (channel 0.2 m,
  # floodplain 3.0 m); with the default "Max Edge Length (m)" it would be ignored
  # and the fallback sizes above used instead.
  zone_size_field: "Max Edge Length"  # per-polygon edge length field
  growth_ratio: 1.2            # max edge-size growth per element (channel -> floodplain)
  channel_anisotropy: 4.0      # along-flow / cross-flow edge ratio in the channel
  max_aspect_ratio: 4.0        # hard cap on cell aspect ratio (AnisoMax + post-mesh edge flips)

friction:
  # .tbl priority: explicit `zones` (MATID) -> roughness zones (geodata.roughness_zones
  # + roughness_table: one `<Zone ID> NIKU <ks> NULL` row each) -> single default.
  roughness_law: 5             # law for roughness-zone rows (5 = NIKU, ks in m)
  default_law: 4               # 4 = Manning (0 NOFR, 1 HAAL, 2 CHEZ, 3 STRI, 5 NIKU, 7 COWH)
  default_coefficient: 0.03
  # lateral (wall) boundary friction; also the roughness used to synthesise the
  # outflow stage-discharge curve when missing.
  boundary_law: 3              # 3 = Strickler
  boundary_coefficient: 38     # Strickler Kst

hydrodynamics:
  regime: steady               # steady | unsteady (the initial run is always steady)
  # With variable_timestep on, time_step is only the conservative CFL START step; the
  # run marches to steady state for `duration` seconds while TELEMAC holds the Courant.
  time_step: 0.25              # conservative CFL start step [s]
  duration: 5000.0             # simulated time [s] for the steady march to convergence
  n_time_steps: 15000          # only bounds a FIXED-step run (variable_timestep: false)
  graphic_printout_period: 500
  listing_printout_period: 500
  finite_volumes: false        # true -> HLLC finite-volume kernel (const viscosity only)
  # Turbulence: "auto" picks k-epsilon (3) / Spalart-Allmaras (6) / Smagorinski (4)
  # from the mesh resolution vs the flow depth and the velocity guess.
  turbulence_model: auto       # auto | 1 const | 3 k-epsilon | 4 Smagorinski | 6 Spalart-Allmaras
  initial_velocity_guess: 1.0  # assumed mean flow [m/s]; sizes eddy viscosity + model choice
  # desired_courant: 0.30      # target Courant for the CFL-adaptive march (default 0.30)

# morphodynamics:              # optional GAIA extension (v1 focuses on 2D hydraulics)
#   enabled: true
#   gaia_results_base: rgaia
#   sediment_classes:
#     - { diameter: 0.0008, density: 2650, shields: 0.047 }

dem_of_difference:
  # Optional DoD (geodata.dem_target - geodata.dem_initial) with a minimum level of
  # detection; off here (dem_initial and dem_target are the same 2025 survey). Point
  # dem_target at a different-epoch DEM to enable. See cases/case-template for options.
  enabled: false
  # uncertainty_initial: 0.05
  # uncertainty_target: 0.03
  # confidence_level: 0.95
  # min_lod: 0.10
  mask_below_lod: true

ground_truth:
  # FlowTracker2 campaigns with corrected DGPS positions (delivered 2026-10-14), one
  # folder per campaign under user-sources/ground-truth/flowtracker/: the point layer
  # (one point per reading, several readings per vertical, EPSG:25832) and the
  # summary workbook it was exported from (the 2025 and March 2026 workbooks hold
  # both gravel bars, KB8 and KB15). See the README there.
  #
  # CALIBRATION: September 1-2, 2025, the flow situation of this model.
  # depth-average reduces each vertical to the USGS three-point depth average of the
  # velocity components, which is what a depth-averaged model computes. The
  # OpenFOAM calibration reads the same table; give it profile: all, so that every
  # reading becomes a target at its own height.
  sources:
    - category: hydraulics
      kind: points
      positions: user-sources/ground-truth/flowtracker/Sep25/KB8_Sep25.gpkg
      profile: depth-average

calibration:
  calibration_quantities: ["WATER DEPTH", "SCALAR VELOCITY"]                    # measured columns used for calibration
  extraction_quantities: ["WATER DEPTH", "SCALAR VELOCITY"]  # quantities pulled from results
  measurement_error: 0.10      # fraction of the measured value
  init_runs: 30                # initial design samples
  max_runs: 50                 # total runs (initial + active-learning iterations)
  gp_library: gpy
  # zone1/zone2 perturb the Nikuradse ks of the two roughness zones; ranges in metres.
  parameters:
    - { name: zone1, min: 0.05, max: 0.50, comment: "channel ks [m] (Nikuradse)" }
    - { name: zone2, min: 0.10, max: 1.00, comment: "floodplain ks [m] (Nikuradse)" }
    # - { name: "gaiaCLASSES SHIELDS PARAMETERS 1", min: 0.030, max: 0.060 }
  # VALIDATION: measurements of other flow situations, which the calibration does
  # not see (never a split of the calibration data). Discharges: the gauge Muehldorf
  # (the user, 2026-10-17: it defines the discharge of the gravel bars better than
  # Kraiburg), averaged over the measurement hours of each campaign
  # (user-sources/ground-truth/hydraulics/discharge-records-*.xlsx).
  validation:
    - name: November 2025
      prescribed_flowrate: 47.8   # [m3/s]
      sources:
        - category: hydraulics
          kind: points
          positions: user-sources/ground-truth/flowtracker/Nov25/KB8_Nov25.gpkg
          profile: depth-average
    - name: March 2026
      prescribed_flowrate: 47.0   # [m3/s]
      sources:
        - category: hydraulics
          kind: points
          positions: user-sources/ground-truth/flowtracker/Mar26/KB8_Mar26.gpkg
          profile: depth-average
    - name: August 2026
      prescribed_flowrate: 53.9   # [m3/s]
      sources:
        - category: hydraulics
          kind: points
          positions: user-sources/ground-truth/flowtracker/Aug26/KB8_Aug26.gpkg
          profile: depth-average
